# 실행 환경: dev | prod
APP_ENV=dev

# 운영에서는 반드시 충분히 긴 무작위 값으로 설정한다.
# 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Flask-SQLAlchemy 연결 문자열
DATABASE_URL=sqlite:///market.db

# 개발 서버(기본 loopback). 핸드폰/ngrok 테스트 때만 HOST=0.0.0.0 사용
HOST=127.0.0.1
PORT=5000

# flask create-admin 명령에서 사용할 수 있으며, 입력 프롬프트 사용을 권장한다.
ADMIN_PASSWORD=
