# 실행 환경: dev | prod
APP_ENV=dev

# 운영에서는 반드시 충분히 긴 무작위 값으로 설정한다.
# 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Flask-SQLAlchemy 연결 문자열
DATABASE_URL=sqlite:///market.db

# 개발 서버(기본 loopback). 같은 LAN에서 직접 접속할 때만 HOST=0.0.0.0 사용.
# ngrok은 loopback 서버에 연결할 수 있으므로 127.0.0.1을 유지한다.
HOST=127.0.0.1
PORT=5000

# 앱이 정확히 한 단계의 신뢰할 역방향 프록시 바로 뒤에 있을 때만 1
# ngrok HTTPS/WSS 검증 시 1, 로컬 직접 실행 시 0
TRUST_PROXY_HEADERS=0

# flask create-admin 명령에서 사용할 수 있으며, 입력 프롬프트 사용을 권장한다.
ADMIN_PASSWORD=
